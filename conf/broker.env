PORT=__PORT__
HOST=127.0.0.1
PUBLIC_ORIGIN=https://__DOMAIN__
LIVEKIT_URL=wss://__DOMAIN__
LIVEKIT_API_URL=http://127.0.0.1:__PORT_LIVEKIT_SIGNAL__
LIVEKIT_API_KEY=__LIVEKIT_API_KEY__
LIVEKIT_API_SECRET=__LIVEKIT_API_SECRET__
# Nginx is the only way in (the broker binds loopback-only above), and it is
# a proxy we control, so the rightmost X-Forwarded-For entry can be trusted
# as the real client address for rate-limiting.
TRUST_PROXY=1
TOKEN_TTL_SECONDS=__TOKEN_TTL_SECONDS__
RATE_LIMIT_PER_MINUTE=__RATE_LIMIT_PER_MINUTE__
